{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openProfiler",
  "version": "0.1.3",
  "identifier": "com.opensoft.openprofiler",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "openProfiler",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A full LLM profile manager",
    "longDescription": "openProfiler discovers and activates user-owned LLM profiles, including Codex and Claude profiles created by workBenches.",
    "copyright": "Copyright 2026 Opensoft Inc.",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
