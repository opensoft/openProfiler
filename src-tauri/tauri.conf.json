{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opensoft Profile Switcher",
  "version": "0.1.0",
  "identifier": "com.opensoft.profile-switcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Opensoft Profile Switcher",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Manage isolated Opensoft Codex profiles",
    "longDescription": "A local-first desktop manager for isolated Codex profiles created by Opensoft workBenches.",
    "copyright": "Copyright 2026 Opensoft Inc.",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
